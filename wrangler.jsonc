{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flint",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",
  // Public URL. A Custom Domain makes Cloudflare create the DNS record and certificate on deploy;
  // the zone must be on this Cloudflare account. The workers.dev URL is off so there's one public address.
  "routes": [{ "pattern": "flint.amarizoft.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The Worker serves the built Vite app from dist/client and handles /api/* itself.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The global Muse Ember budget (src/worker/budget.ts): one object, so the cap is strict.
  // The per-visit message cap (src/worker/session-cap.ts): one object per session.
  "durable_objects": {
    "bindings": [
      { "name": "BUDGET", "class_name": "BudgetDO" },
      { "name": "SESSION_CAP", "class_name": "SessionCapDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BudgetDO"] },
    { "tag": "v2", "new_sqlite_classes": ["SessionCapDO"] }
  ],
  // Rate limits on live turns per IP (src/worker/rate-limits.ts) and on access-code checks per IP
  // (src/worker/access.ts). Period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RATE_LIMIT_IP", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_CODE", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    // Kill switch: anything other than "on" turns live mode off.
    "LIVE_MODE": "on",
    // Global Muse Ember budget in US dollars.
    "TOKEN_BUDGET_USD": "3",
    // Live messages one session (a browser tab) may send in total.
    "SESSION_MESSAGE_CAP": "50",
    // Muse Ember (Meta Responses API) base URL; tests and local runs can point it at a fake.
    "MODEL_API_BASE_URL": "https://api.meta.ai/v1"
  },
  "env": {
    // Browser tests only (`wrangler dev --env e2e`, see playwright.config.ts). Every test request comes
    // from 127.0.0.1, so the rate limits are lifted; bindings and vars aren't inherited, so they're
    // repeated here. Playwright points MODEL_API_BASE_URL at the fake Ember with --var.
    "e2e": {
      "durable_objects": {
        "bindings": [
          { "name": "BUDGET", "class_name": "BudgetDO" },
          { "name": "SESSION_CAP", "class_name": "SessionCapDO" }
        ]
      },
      "ratelimits": [
        { "name": "RATE_LIMIT_IP", "namespace_id": "1001", "simple": { "limit": 100000, "period": 60 } },
        { "name": "RATE_LIMIT_CODE", "namespace_id": "1003", "simple": { "limit": 100000, "period": 60 } }
      ],
      "vars": {
        "LIVE_MODE": "on",
        "TOKEN_BUDGET_USD": "3",
        "SESSION_MESSAGE_CAP": "100000",
        "MODEL_API_BASE_URL": "http://127.0.0.1:1/unset"
      }
    }
  }
  // Secrets (EMBER_API_KEY, ACCESS_CODE) live in .dev.vars locally; see .dev.vars.example.
}
