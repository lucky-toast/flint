{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flint",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",
  // The Worker serves the built Vite app from dist/client and handles /api/* itself.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Kill switch: anything other than "on" turns live mode off.
    "LIVE_MODE": "on",
    // Global Muse Ember budget in US dollars.
    "TOKEN_BUDGET_USD": "3",
    // Muse Ember (Meta Responses API) base URL; tests and local runs can point it at a fake.
    "MODEL_API_BASE_URL": "https://api.meta.ai/v1"
  }
  // Secrets (EMBER_API_KEY, ACCESS_CODE) live in .dev.vars locally; see .dev.vars.example.
}
